{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
{{template "head" .}}
</head>
<body class="{{.BodyClass}}">
<a class="skip-link" href="#main">Skip to content</a>
<div class="container">
{{.Nav}}
<main class="main-content" id="main">
<div class="topbar"><button type="button" class="menu-toggle" aria-controls="sidebar" aria-expanded="false">Menu</button>{{template "breadcrumb" .}}{{template "theme-toggle" .}}</div>
{{template "header" .}}
{{if eq .Kind "index"}}{{template "index" .}}{{else if eq .Kind "element"}}{{template "element" .}}{{else}}{{template "view" .}}{{end}}
{{template "pager" .}}
{{template "footer" .}}
</main>
</div>
<script src="{{.Root}}assets/search-index.js"></script>
<script src="{{.Root}}assets/site.js"></script>
</body>
</html>
{{end}}

{{define "head"}}<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.Title}} · {{.Project.Name}}</title>
{{with or .Lead .Project.Description}}<meta name="description" content="{{.}}">
{{end}}<script>try{var t=localStorage.getItem("loko-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}document.documentElement.classList.add("js")</script>
<link rel="stylesheet" href="{{.Root}}assets/fonts.css">
<link rel="stylesheet" href="{{.Root}}assets/icons.css">
<link rel="stylesheet" href="{{.Root}}assets/style.css">
<link rel="stylesheet" href="{{.Root}}assets/custom.css">{{end}}

{{define "header"}}<header class="page-header"><div class="accent-bar" aria-hidden="true"></div>
{{with .Label}}<p class="kind-label">{{.}}</p>
{{end}}<h1>{{if .Icon}}{{template "icon-tile" (tile .IconKind .Icon)}}{{end}}<span class="title">{{.Title}}</span></h1>
{{with .Meta}}<p class="meta">{{range $i, $m := .}}{{if $i}}<span class="sep" aria-hidden="true"> · </span>{{end}}<span>{{$m}}</span>{{end}}</p>
{{end}}{{with .Lead}}<p class="lead">{{.}}</p>
{{end}}</header>{{end}}

{{define "nav"}}<aside class="sidebar" id="sidebar">
<div class="brand"><a class="brand-link" href="{{.Root}}index.html"><img src="{{.Root}}assets/brand/madstone-eye.svg" alt="" width="28" height="28"><span class="wordmark">LOKO<span class="cursor" aria-hidden="true">_</span></span></a></div>
<div class="sidebar-header"><p class="project-name"><a href="{{.Root}}index.html">{{.Project.Name}}</a></p>{{with .Project.Description}}<p class="project-description">{{.}}</p>{{end}}</div>
<div class="sidebar-nav" data-root="{{.Root}}">
<div class="search-box"><input type="search" id="search" placeholder="Search elements…" class="search-input" aria-label="Search elements"></div>
<ul id="search-results" class="element-list" hidden></ul>
<div class="nav-section"><h2>Architecture</h2>
<nav class="tree" aria-label="Architecture"><ul>{{range .Tree}}{{template "tree-node" (treeData $.Root .)}}{{end}}</ul></nav></div>
<div class="nav-section"><h2>Views</h2>
<ul class="system-list">{{range .Projection.Views}}{{$here := and $.View (eq $.View.View.ID .View.ID)}}<li{{if $here}} class="active"{{end}}><a class="system-link" href="{{$.Root}}{{.PagePath}}"{{if $here}} aria-current="page"{{end}}>{{.View.Title}}</a> <small>{{.View.Kind}}</small></li>{{end}}</ul></div>
</div>
<p class="sidebar-footer">Generated from <code>*.loko.hcl</code>. Edit the source, not these pages.</p>
</aside>{{end}}

{{define "tree-node"}}{{$n := .Node}}{{$name := or $n.Ref.Title $n.Ref.Name}}<li class="tree-item{{if $n.Current}} active{{end}}"><div class="tree-row">{{if $n.HasChildren}}<button type="button" class="twisty" aria-expanded="{{if $n.Children}}true{{else}}false{{end}}" aria-label="Expand or collapse {{$name}}">{{if $n.Children}}▾{{else}}▸{{end}}</button>{{else}}<span class="twisty-spacer" aria-hidden="true"></span>{{end}}<i class="icon kind-icon-{{$n.Ref.Kind}}" data-icon="{{kindIcon $n.Ref.Kind}}" aria-hidden="true"></i><a href="{{.Root}}{{$n.Ref.PagePath}}" title="{{$name}}"{{if $n.Current}} aria-current="page"{{end}}>{{$name}}</a></div>{{if $n.Children}}<ul>{{range $n.Children}}{{template "tree-node" (treeData $.Root .)}}{{end}}</ul>{{end}}</li>{{end}}

{{define "breadcrumb"}}{{if .Crumbs}}<nav class="breadcrumb" aria-label="Breadcrumb"><ol>{{range .Crumbs}}<li><a href="{{$.Root}}{{.PagePath}}">{{or .Title .Name}}</a></li>{{end}}<li><span aria-current="page">{{.Title}}</span></li></ol></nav>{{end}}{{end}}

{{define "pager"}}{{with .Element}}{{if or .Prev .Next}}<nav class="pager" aria-label="Siblings">{{with .Prev}}<a class="pager-prev" rel="prev" href="{{$.Root}}{{.PagePath}}"><span class="pager-dir">← Previous</span><span class="pager-name">{{or .Title .Name}}</span></a>{{end}}{{with .Next}}<a class="pager-next" rel="next" href="{{$.Root}}{{.PagePath}}"><span class="pager-dir">Next →</span><span class="pager-name">{{or .Title .Name}}</span></a>{{end}}</nav>
{{end}}{{end}}{{end}}

{{define "theme-toggle"}}<button type="button" id="theme-toggle" class="theme-toggle" aria-pressed="false" hidden>Dark theme</button>{{end}}

{{define "footer"}}<footer class="footer"><p>Generated by <a href="https://github.com/madstone-tech/loko">loko</a>. Edit the architecture source, not this page.</p></footer>{{end}}
