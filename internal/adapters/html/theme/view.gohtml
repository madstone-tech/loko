{{define "view"}}{{with .View}}{{template "diagram" (diagramData $.Root . $.Inline "view-caption" $.HasD2)}}{{if hasLegend .}}<p class="diagram-legend">{{if anyAsync .}}<span class="legend-async">Long dashes: asynchronous.</span>{{end}}{{if anyCrossing .}} <span class="legend-crossing">Short dashes: leaves this view.</span>{{end}}</p>{{end}}
{{template "in-this-view" $}}
{{with nodeRows .}}<section><h2>Nodes</h2><table class="nodes"><thead><tr><th>Node</th><th>Title</th><th>Technology</th><th>Description</th><th>Tags</th></tr></thead><tbody>
{{range .}}<tr><td>{{.Path}}</td><td>{{.Title}}</td><td>{{.Technology}}</td><td>{{.Description}}</td><td>{{join .Tags ", "}}</td></tr>
{{end}}</tbody></table></section>
{{end}}{{with .Steps}}<section><h2>Steps</h2><table class="steps"><thead><tr><th>#</th><th>From</th><th>To</th><th>Description</th></tr></thead><tbody>
{{range .}}<tr><td>{{.Number}}</td><td><a href="{{$.Root}}{{.From.PagePath}}">{{or .From.Title .From.Name}}</a></td><td><a href="{{$.Root}}{{.To.PagePath}}">{{or .To.Title .To.Name}}</a></td><td>{{.Text}}{{if .Reply}} (reply){{end}}</td></tr>
{{end}}</tbody></table></section>
{{end}}{{if crossing .}}<section><h2>Leaves this view</h2><ul class="element-list">
{{range crossing .}}<li>{{.}}</li>
{{end}}</ul></section>{{end}}{{end}}{{end}}

{{define "in-this-view"}}{{with .View}}<section class="in-this-view" id="in-this-view" aria-labelledby="in-this-view-h"><h2 id="in-this-view-h">In this view</h2>
<ul class="rows">{{range .Nodes}}{{if or (eq .Role "element") (eq .Role "instance")}}<li class="row {{join .Style.Classes " "}}">{{template "icon-tile" (tile .Kind (nodeIcon .))}}<div class="row-body"><div class="row-head">{{if .Link}}<a href="{{$.Root}}{{.Link}}">{{or .Title .Label}}</a>{{else}}<span class="row-name">{{or .Title .Label}}</span>{{end}} <span class="row-kind">{{or .Kind .Role}}</span>{{with .Technology}} {{template "chip" .}}{{end}}</div>{{with .Description}}<p class="row-desc">{{.}}</p>{{end}}</div></li>
{{end}}{{end}}</ul></section>
{{end}}{{end}}
