# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.release — used only by GoReleaser (dockers_v2).
#
# GoReleaser builds loko first and stages one binary per platform in the build
# context as <os>/<arch>/loko, then runs a single buildx build for every
# platform. This file only packages that binary: diagrams render in-process,
# so the image carries no d2 binary and no other executable.
#
# For local images, use the root Dockerfile:
#   docker build -t loko:dev .
# =============================================================================
FROM gcr.io/distroless/static-debian12:nonroot

# Set by buildx for each platform, e.g. linux/arm64.
ARG TARGETPLATFORM

COPY $TARGETPLATFORM/loko /usr/local/bin/loko

# Project directories are mounted here at `docker run` time.
WORKDIR /workspace

# loko is the entrypoint, so `docker run ghcr.io/madstone-tech/loko build`
# runs `loko build`. The nonroot tag runs as uid 65532.
ENTRYPOINT ["/usr/local/bin/loko"]
CMD ["--help"]
